# Cloudflare Pages / Server Environment Variables
# In Cloudflare Pages, configure these in:
# Pages Project -> Settings -> Environment variables -> Production & Preview

# Admin email address allowed to access the admin portal
ADMIN_EMAIL=

# Admin password (can be plain text or a secure bcrypt hash starting with $2a$, $2b$, or $2y$)
ADMIN_PASSWORD=

# Cryptographic secret used for HMAC-SHA256 session token and rate-limit signing (min 32 random characters recommended)
SESSION_SECRET=

# Gemini API Key for AI features (optional)
GEMINI_API_KEY=
