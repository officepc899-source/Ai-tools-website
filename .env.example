# AIToolNest Admin Authentication Environment Variables
# Provide your desired administrator credentials in your environment variables or local .env file.

# Required: Administrator login email address (e.g. your-email@domain.com)
ADMIN_EMAIL=

# Required: Administrator password (plain text or bcrypt hash starting with $2a$, $2b$, or $2y$)
ADMIN_PASSWORD=

# Required: Cryptographically random secret string used to sign session cookies and HMAC tokens (at least 32 characters recommended)
SESSION_SECRET=
